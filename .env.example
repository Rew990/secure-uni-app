# Copy to .env and change every secret before running. Never commit .env.
APP_ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=30

# AES-256-GCM key, base64 (32 bytes). Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# SQLite database file (updated specs: FastAPI + SQLite).
# In Docker the file lives in the app_data volume at /code/data.
DATABASE_URL=sqlite:///./data/university.db

# Seed users created on first start (dev only)
SEED_DEMO_USERS=true
